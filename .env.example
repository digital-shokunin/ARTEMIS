# OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Web Search Configuration (Optional - for supervisor web_search tool)
# Get free API key at: https://brave.com/search/api/ (2000 queries/month free)
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
# Alternative: SERPAPI_API_KEY=your-serpapi-key-here (100 queries/month free)

# Amazon Bedrock Configuration
LLM_PROVIDER=bedrock
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_AVAILABLE_MODELS=us.anthropic.claude-opus-4-5-20251101-v1:0,us.anthropic.claude-sonnet-4-5-20250929-v1:0,anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token

# Subagent Model (for codex instances spawned by supervisor)
# Using Haiku for faster/cheaper worker tasks (recommended)
# Can also use BEDROCK_MODEL_ID if you want same model everywhere
SUBAGENT_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: Override default models
# SUPERVISOR_MODEL=openai/o1-preview
# SUMMARIZATION_MODEL=openai/o4-mini
# ROUTER_MODEL=openai/o4-mini

# Optional: Override TODO generator models
# TODO_GENERATOR_OPENROUTER_MODEL=anthropic/claude-opus-4.1
# TODO_GENERATOR_OPENAI_MODEL=gpt-5
# TODO_GENERATOR_BEDROCK_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0

# Optional: Override prompt generator model for custom system prompts
# PROMPT_GENERATOR_MODEL=anthropic/claude-opus-4.1

# Optional: Override available models for model switching (comma-separated)
# OPENROUTER_AVAILABLE_MODELS=anthropic/claude-sonnet-4,openai/o3,anthropic/claude-opus-4,google/gemini-2.5-pro,openai/o3-pro
# OPENAI_AVAILABLE_MODELS=o3,gpt-5
# BEDROCK_AVAILABLE_MODELS=us.anthropic.claude-opus-4-5-20251101-v1:0,us.anthropic.claude-sonnet-4-5-20250514-v1:0
